# BlockDust Marketplace Environment Configuration

# ─── Data backend (self-hosted PostgreSQL) ─────────────────────────────────
# Data access goes through the backend in backend/ (Express + PostgreSQL).
# See backend/SETUP.md. There is no Supabase and no Vercel in this stack.
#
# Frontend: only needed if the backend is on a DIFFERENT origin than the SPA.
# Leave unset for same-origin (/api/*).
# VITE_API_BASE_URL=https://api.blockdust.xyz
#
# Backend (set for the backend process / systemd unit, NOT the Vite build):
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/blockdust
# PORT=8787
# ENABLE_CRONS=true
# HYVE_RPC_URL / VITRUVEO_RPC_URL   override the proxied upstream RPC endpoints

# ─── Chains ────────────────────────────────────────────────────────────────
# The supported chains live in src/config/chains.js (Hyve 7847 is the default,
# Vitruveo 1490 is secondary). Chain selection is a runtime user choice, so
# there is no single "active chain" env var.
#
# Per-chain overrides use VITE_<CHAINKEY>_<FIELD>; all are optional and fall
# back to the defaults baked into chains.js:
# VITE_HYVE_RPC_URL=
# VITE_HYVE_MARKETPLACE_ADDRESS=0x89610b27E8f5685681666edf901Ad5c69d89DfB6
# VITE_VITRUVEO_RPC_URL=https://rpc.vitruveo.ai
# VITE_VITRUVEO_MARKETPLACE_ADDRESS=0x67cfCf4bE8447a083E6A2A1135Bd998FE91d3854

# Legacy single-chain vars — still honored as the Vitruveo fallback.
VITE_RPC_URL=https://rpc.vitruveo.ai
VITE_MARKETPLACE_ADDRESS=0x67cfCf4bE8447a083E6A2A1135Bd998FE91d3854

# WalletConnect Project ID (for Web3Modal/AppKit)
# Get your project ID from https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=demo-project-id

# ─── Vitruveo-only contracts ───────────────────────────────────────────────
# These back the DeFi features (Vibe, RevShare, WVTRU wrapping, Uniswap
# pricing) that exist ONLY on Vitruveo. They are chain-gated via the
# `features` map in chains.js and are unused while Hyve is the active chain.
VITE_USDC_ADDRESS=0xbCfB3FCa16b12C7756CD6C24f1cC0AC0E38569CF
VITE_WVTRU_ADDRESS=0x3ccc3F22462cAe34766820894D04a40381201ef9
VITE_VIBE_SINK_ADDRESS=0x8e7C7f0DF435Be6773641f8cf62C590d7Dde5a8a
VITE_UNIV3_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_UNIV3_FACTORY_ADDRESS=0x6196a7a6108B15a2cc24DdaB41C8CC3098C06351

# RevShare Contracts (BlockDust Revenue Sharing — Vitruveo only)
VITE_REVSHARE_NFT_ADDRESS=0x820deE1a5cbfB56d453bEF9412e8511Fc383eD54
VITE_REVSHARE_TREASURY_ADDRESS=0xCfd58726C7f6ee235c02E732968b9351d4a3Ef53

# New Combined RevShare Contract (NFT + Treasury in one)
VITE_REVSHARE_NFT_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Feature Flags
VITE_ENABLE_AUCTIONS=0
VITE_AUCTIONS_WALLET_ALLOWLIST=

# Day-1 Compliance Flags (all default OFF for zero-downtime rollout)
VITE_FLAG_DMCA=0
VITE_FLAG_WISP=0
VITE_FLAG_SANCTIONS=0
VITE_FLAG_TAX_SWITCH=0

# Compliance Configuration
VITE_OFAC_PROVIDER=local
VITE_TAX_GEO_MODE=none
VITE_DMCA_AGENT_EMAIL=legal@blockdust.xyz

# Debug and Development Settings
# Set to 'true' to enable verbose console logging
VITE_DEBUG_MODE=false

# Performance Configuration
# Maximum number of marketplace listings to scan (default: 50)
VITE_MAX_LISTING_SCAN=50
# Timeouts in milliseconds
VITE_CONTRACT_CALL_TIMEOUT=8000
VITE_METADATA_FETCH_TIMEOUT=10000
# Concurrency limits to reduce server load
VITE_MAX_CONCURRENT_METADATA_FETCHES=3
VITE_MAX_CONCURRENT_CONTRACT_CALLS=2

# NOTE: Blockchain scanning is deliberately bounded to prevent mass data
# collection (a past incident produced 15,000+ records):
# - Scans use a trailing block window, not full history (see nftScanner.js)
# - NFT discovery favors known contracts + recent transfers
# - The limits above (scan cap, timeouts, concurrency) are the tuning knobs
#
# Widening these is a deliberate decision — see src/utils/nftScanner.js.
